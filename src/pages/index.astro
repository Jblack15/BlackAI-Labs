---
import BaseLayout from "../layouts/BaseLayout.astro";
const stats=[['73%','of fleet managers say claims processing is their #1 bottleneck'],['$2,400','average cost per claim in admin overhead'],['8.5 days','average cycle time for manual claims'],['3.2 hrs','of adjuster time wasted per estimate']];
const features=[['01','AI damage analysis','Turn inspection photos into an accurate damage assessment in minutes.'],['02','Estimate generation','Generate fair, data-driven repair estimates with labor and parts.'],['03','Claim tracking','Keep every stakeholder aligned with real-time status updates.']];
const testimonials=[['“FleetClaim AI cuts the busywork out of every claim. Our team gets hours back every week.”','Operations leader, regional fleet'],['“We can finally see what is happening across every repair and approval.”','Claims manager, national carrier']];
---
<BaseLayout title="AI-Powered Fleet Claims Management" description="Fleet claims management with AI damage analysis and repair estimates. FleetClaim AI cuts claim processing from days to minutes. Start your free trial.">
 <section class="relative overflow-hidden border-b border-navy-200/70 dark:border-navy-800"><div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_75%_20%,rgba(59,130,246,.18),transparent_38%),linear-gradient(135deg,#f6f8fc,#eff6ff)] dark:bg-[radial-gradient(circle_at_75%_20%,rgba(37,99,235,.24),transparent_38%),linear-gradient(135deg,#0b172a,#14263f)]"></div><div class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.02fr_.98fr] lg:px-8 lg:py-32"><div><span class="badge mb-7">The intelligent claims operating system</span><h1 class="heading-1 max-w-3xl">Stop losing money to manual claims. <span class="text-electric-600 dark:text-electric-400">AI does the heavy lifting.</span></h1><p class="body-large mt-6 max-w-xl">Every day your team spends on paperwork, estimates, and adjuster calls is money leaking from your bottom line. FleetClaim AI cuts claim processing from days to minutes — with 99.7% accuracy.</p><div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href="/contact" class="btn-primary px-6 py-3.5">Start saving today <span>→</span></a><a href="#how-it-works" class="btn-secondary px-6 py-3.5">See how it works</a></div><div class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm text-navy-600 dark:text-navy-300"><span>✓ No credit card required</span><span>✓ 14-day free trial</span><span>✓ 48-hour onboarding</span></div></div><div class="relative"><div class="absolute -inset-5 rounded-[2rem] bg-electric-500/10 blur-2xl"></div><div class="relative overflow-hidden rounded-2xl border border-navy-200 bg-white p-4 shadow-2xl shadow-navy-900/10 dark:border-navy-700 dark:bg-navy-900 sm:p-6"><div class="mb-5 flex items-center justify-between"><div><p class="text-xs font-semibold uppercase tracking-widest text-navy-400">Claims overview</p><p class="mt-1 text-lg font-bold text-navy-950 dark:text-white">Fleet performance</p></div><span class="rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">Live preview</span></div><div class="grid grid-cols-2 gap-3"><div class="rounded-xl bg-navy-50 p-4 dark:bg-navy-800"><p class="text-xs text-navy-500 dark:text-navy-400">Total claims</p><p class="mt-2 text-2xl font-bold text-navy-950 dark:text-white">1,247</p><p class="mt-1 text-xs font-medium text-emerald-600">↑ 12.4%</p></div><div class="rounded-xl bg-electric-50 p-4 dark:bg-electric-950/40"><p class="text-xs text-electric-700 dark:text-electric-300">Estimate accuracy</p><p class="mt-2 text-2xl font-bold text-navy-950 dark:text-white">99.7%</p><p class="mt-1 text-xs font-medium text-electric-600">↑ 0.3%</p></div></div><div class="mt-4 rounded-xl border border-navy-200 p-4 dark:border-navy-700"><div class="flex items-center justify-between text-xs"><span class="font-semibold text-navy-700 dark:text-navy-200">Claims processed</span><span class="text-navy-400">Last 30 days</span></div><div class="mt-6 flex h-28 items-end gap-2">{[30,48,42,65,55,74,68,90,78,100,88,96].map((height)=><span class="flex-1 rounded-t bg-electric-500/80" style={`height:${height}%`}></span>)}</div></div></div></div></div></section>
 <section class="border-b border-navy-200/70 bg-white py-14 dark:border-navy-800 dark:bg-navy-900"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><p class="mb-8 text-center text-xs font-bold uppercase tracking-[.2em] text-navy-400">The hidden cost of manual claims</p><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{stats.map(([num,label])=><div class="rounded-2xl border border-navy-200/70 bg-navy-50 p-6 dark:border-navy-700 dark:bg-navy-800"><p class="text-3xl font-bold text-navy-950 dark:text-white">{num}</p><p class="mt-2 text-sm leading-6 text-navy-600 dark:text-navy-300">{label}</p></div>)}</div></div></section>
 <section id="how-it-works" class="section"><div class="section-inner"><div class="max-w-2xl"><span class="badge">One connected workflow</span><h2 class="heading-2 mt-5">From first photo to final approval, without the busywork.</h2><p class="body-large mt-5">FleetClaim AI brings your entire claims operation into one clear, collaborative workspace.</p></div><div class="mt-14 grid gap-6 md:grid-cols-3">{features.map(([number,title,description])=><div class="card p-7"><span class="font-mono text-sm font-bold text-electric-600 dark:text-electric-400">{number}</span><h3 class="heading-3 mt-7">{title}</h3><p class="body-base mt-3">{description}</p><a href="/docs" class="mt-6 inline-flex text-sm font-semibold text-electric-600 dark:text-electric-400">Learn more →</a></div>)}</div></div></section>
 <section class="section border-y border-navy-200/70 bg-navy-950 dark:border-navy-800"><div class="section-inner grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><span class="badge border-electric-800 bg-electric-950 text-electric-300">Built for the whole team</span><h2 class="mt-6 text-3xl font-bold tracking-tight text-white sm:text-4xl">A clearer path through every claim.</h2><p class="mt-5 text-lg leading-8 text-navy-300">Connect fleet operators, repair shops, insurers, and adjusters around a shared source of truth.</p><a href="/contact" class="btn-primary mt-8">See FleetClaim AI in action →</a></div><div class="grid gap-4 sm:grid-cols-2">{['Instant AI-powered damage analysis','Automated tracking dashboard','Real-time status updates','Fair, data-driven estimates'].map((item)=><div class="rounded-xl border border-navy-700 bg-navy-900 p-5 text-sm font-medium text-navy-100"><span class="mr-3 text-electric-400">✓</span>{item}</div>)}</div></div></section>
 <section class="section"><div class="section-inner"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><span class="badge">What teams are saying</span><h2 class="heading-2 mt-5">Less paperwork. More progress.</h2></div><a href="/contact" class="link text-sm font-semibold">Talk to our team →</a></div><div class="mt-12 grid gap-6 md:grid-cols-2">{testimonials.map(([quote,author])=><figure class="card p-8"><div class="text-2xl tracking-widest text-electric-500">★★★★★</div><blockquote class="mt-6 text-xl font-medium leading-8 text-navy-900 dark:text-white">{quote}</blockquote><figcaption class="mt-6 text-sm text-navy-500 dark:text-navy-400">{author}</figcaption></figure>)}</div></div></section>
 <section class="px-4 pb-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl overflow-hidden rounded-3xl bg-electric-600 px-6 py-14 text-center shadow-xl shadow-electric-600/20 sm:px-12"><h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Move claims forward.</h2><p class="mx-auto mt-4 max-w-xl text-lg text-electric-100">Start your 14-day free trial and see what your team can do with the busywork out of the way.</p><a href="/contact" class="mt-8 inline-flex rounded-xl bg-white px-6 py-3.5 font-semibold text-electric-700 transition hover:bg-electric-50">Start saving today →</a></div></section>
</BaseLayout>
