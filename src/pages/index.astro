---
import BaseLayout from "../layouts/BaseLayout.astro";

const partners = ["Apex Logistics", "Metro Fleet", "Coastal Transport", "National Claims", "Precision Repair", "Allied Insurance"];
const integrations = [
  ["CCC ONE", "text-blue-600 dark:text-blue-400"], ["Mitchell", "text-indigo-600 dark:text-indigo-400"],
  ["Audatex", "text-cyan-600 dark:text-cyan-400"], ["QuickBooks", "text-emerald-600 dark:text-emerald-400"], ["Salesforce", "text-sky-600 dark:text-sky-400"]
];
---

<BaseLayout title="AI-Powered Fleet Claims Management" description="Fleet claims management powered by AI damage analysis, faster repair estimates, and insurance claims automation for modern fleets.">
  <!-- 1. Hero -->
  <section class="relative overflow-hidden border-b border-navy-200/60 dark:border-navy-800/60 bg-gradient-to-br from-electric-50 via-white to-navy-50/70 dark:from-navy-950 dark:via-navy-950 dark:to-electric-950/30">
    <div class="absolute -top-32 -right-20 h-96 w-96 rounded-full bg-electric-400/15 blur-3xl" aria-hidden="true"></div>
    <div class="section-inner relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:py-28">
      <div>
        <span class="badge mb-7">🚀 Now in Public Beta</span>
        <h1 class="heading-1 mb-6 max-w-2xl text-balance text-5xl sm:text-6xl lg:text-[4.25rem]">Smarter Fleet Claims, <span class="bg-gradient-to-r from-electric-500 to-navy-600 bg-clip-text text-transparent dark:from-electric-400 dark:to-electric-300">Faster Settlements</span></h1>
        <p class="body-large mb-9 max-w-xl">Turn vehicle damage photos into accurate estimates and resolved claims in minutes—not days. FleetClaim AI brings every step of your claims operation into one intelligent workflow.</p>
        <div class="flex flex-col gap-4 sm:flex-row"><a href="/contact" class="btn-primary px-7 py-4">Request a Demo <span aria-hidden="true">→</span></a><a href="/pricing" class="btn-secondary px-7 py-4">View Pricing</a></div>
        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-navy-500 dark:text-navy-400"><span>✓ SOC 2-ready workflows</span><span>✓ Built for modern fleets</span></div>
      </div>
      <div class="hero-grid relative rounded-3xl p-4 sm:p-7"><div class="absolute inset-0 rounded-3xl bg-electric-500/5 dark:bg-electric-400/5"></div><img src="/hero-illustration.png" alt="FleetClaim AI claims dashboard" class="relative z-10 w-full rounded-2xl shadow-2xl shadow-navy-950/20 ring-1 ring-navy-200/70 dark:ring-navy-700/70" /></div>
    </div>
  </section>

  <!-- 2. Trusted by -->
  <section class="border-b border-navy-200/60 py-12 dark:border-navy-800/60"><div class="section-inner"><p class="mb-7 text-center text-xs font-bold uppercase tracking-[0.2em] text-navy-400 dark:text-navy-500">Trusted by leading fleets and insurers</p><div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">{partners.map((partner) => <div class="flex items-center justify-center gap-2 rounded-xl border border-navy-200/70 bg-white/70 px-3 py-4 text-center text-xs font-bold text-navy-500 shadow-sm dark:border-navy-800 dark:bg-navy-900/60 dark:text-navy-400"><span class="h-2 w-2 rounded-sm bg-electric-500/70"></span>{partner}</div>)}</div></div></section>

  <!-- 3. How it works -->
  <section class="section relative overflow-hidden"><div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-electric-500/5 blur-3xl" aria-hidden="true"></div><div class="section-inner relative"><div class="mb-14 max-w-2xl"><span class="badge mb-5">A simpler workflow</span><h2 class="heading-2 mb-4">From first photo to final settlement</h2><p class="body-large">A streamlined operating system for teams that cannot afford claims to slow them down.</p></div><div class="relative grid gap-8 md:grid-cols-3 md:gap-10"><div class="absolute left-[16%] right-[16%] top-10 hidden h-px bg-gradient-to-r from-electric-300 via-electric-500 to-electric-300 md:block"></div>{[{n:"01",icon:"↥",title:"Upload",desc:"Upload damage photos via mobile or desktop"},{n:"02",icon:"✦",title:"Analyze",desc:"AI analyzes damage and generates estimates"},{n:"03",icon:"✓",title:"Settle",desc:"Review, approve, and settle claims faster"}].map((step) => <div class="relative"><div class="mb-5 flex items-center justify-between"><span class="text-5xl font-black tracking-tight text-electric-500/25 dark:text-electric-400/25">{step.n}</span><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-electric-400 to-electric-700 text-xl font-bold text-white shadow-lg shadow-electric-500/20">{step.icon}</span></div><h3 class="heading-3 mb-2">{step.title}</h3><p class="body-base max-w-xs">{step.desc}</p></div>)}</div></div></section>

  <!-- 4. Product preview -->
  <section class="section border-y border-navy-200/60 bg-navy-50/60 dark:border-navy-800/60 dark:bg-navy-900/30"><div class="section-inner"><div class="mx-auto mb-12 max-w-2xl text-center"><span class="badge mb-5">One source of truth</span><h2 class="heading-2 mb-4">Everything you need in one dashboard</h2><p class="body-large">Give every stakeholder a clear view of damage, estimates, approvals, and claim status.</p></div><div class="mx-auto max-w-5xl rounded-2xl border border-navy-200/80 bg-navy-950 p-2 shadow-2xl shadow-navy-950/20 dark:border-navy-700"><div class="flex items-center gap-2 border-b border-white/10 px-3 py-3"><span class="h-2.5 w-2.5 rounded-full bg-red-400"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span><span class="ml-3 h-2.5 w-32 rounded-full bg-white/10"></span></div><img src="/hero-illustration.png" alt="FleetClaim AI dashboard preview" class="block w-full rounded-b-lg" /></div></div></section>

  <!-- 5. Features -->
  <section class="section"><div class="section-inner"><div class="mb-14 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><span class="badge mb-5">Built for operations</span><h2 class="heading-2 mb-4">The intelligence behind every claim</h2><p class="body-large max-w-2xl">Replace fragmented tools and manual follow-ups with a claims platform designed for speed, accuracy, and accountability.</p></div><a href="/docs" class="link whitespace-nowrap font-semibold">Explore the platform →</a></div><div class="grid gap-6 sm:grid-cols-2">{[{icon:"✦",title:"AI Damage Analysis",desc:"Identify damage type, severity, and affected parts from photos with consistent, explainable results."},{icon:"▤",title:"Smart Estimates",desc:"Generate detailed repair estimates with labor hours, parts pricing, and OEM procedures in seconds."},{icon:"↗",title:"Claim Tracking",desc:"Keep every claim moving with real-time status, ownership, and automated workflow handoffs."},{icon:"⌘",title:"Integrations",desc:"Connect the tools your team already trusts, from CCC ONE and Mitchell to QuickBooks and more."}].map((feature) => <div class="card group p-7 sm:p-8"><div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-electric-400 to-electric-700 text-xl font-bold text-white shadow-lg shadow-electric-500/20 transition-transform group-hover:scale-110">{feature.icon}</div><h3 class="heading-3 mb-3">{feature.title}</h3><p class="body-base mb-5">{feature.desc}</p><a href="/docs" class="link text-sm font-semibold">Learn more →</a></div>)}</div></div></section>

  <!-- 6. Integrations -->
  <section class="border-y border-navy-200/60 bg-white py-16 dark:border-navy-800/60 dark:bg-navy-950"><div class="section-inner text-center"><p class="mb-8 text-sm font-semibold text-navy-500 dark:text-navy-400">Integrates with your existing tools</p><div class="flex flex-wrap justify-center gap-3">{integrations.map(([name, color]) => <span class={`rounded-lg border border-navy-200 bg-navy-50 px-5 py-3 text-sm font-extrabold tracking-tight ${color} dark:border-navy-800 dark:bg-navy-900`}>{name}</span>)}</div></div></section>

  <!-- 7. CTA -->
  <section class="section"><div class="section-inner"><div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-electric-500 via-electric-600 to-navy-800 px-6 py-20 text-center shadow-2xl shadow-electric-500/20 sm:px-12"><div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div><div class="relative"><span class="badge mb-6 bg-white/15 text-white">Move claims forward</span><h2 class="mb-5 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">Ready to transform your claims process?</h2><p class="mx-auto mb-9 max-w-xl text-lg leading-relaxed text-electric-100">Join modern fleet teams saving hours on every claim with intelligent automation.</p><div class="flex flex-col items-center justify-center gap-4 sm:flex-row"><a href="/contact" class="inline-flex items-center gap-2 rounded-lg bg-white px-8 py-4 font-bold text-electric-600 transition hover:bg-electric-50">Get Started Free <span aria-hidden="true">→</span></a><a href="/docs" class="font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white">or browse our documentation</a></div></div></div></div></section>
</BaseLayout>
