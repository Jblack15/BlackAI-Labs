---
import BaseLayout from "../layouts/BaseLayout.astro";

const integrations = [
  ["CCC ONE", "text-blue-600 dark:text-blue-400"], ["Mitchell", "text-indigo-600 dark:text-indigo-400"],
  ["Audatex", "text-cyan-600 dark:text-cyan-400"], ["QuickBooks", "text-emerald-600 dark:text-emerald-400"], ["Salesforce", "text-sky-600 dark:text-sky-400"]
];

const painStats = [
  { number: "73%", label: "of fleet managers say claims processing is their #1 bottleneck", icon: "⚠" },
  { number: "$2,400", label: "average cost per claim in admin overhead", icon: "💸" },
  { number: "8.5 days", label: "average cycle time for manual claims", icon: "⏱" },
  { number: "3.2 hrs", label: "of adjuster time wasted per estimate", icon: "🕐" },
];

const objections = [
  {
    question: "Is AI damage analysis really accurate?",
    answer: "Yes — FleetClaim AI achieves 99.7% verified accuracy across 50,000+ claims processed. Our models are continuously trained on real-world fleet damage data and validated by certified adjusters.",
    icon: "🎯",
  },
  {
    question: "What about my existing tools?",
    answer: "FleetClaim integrates with CCC ONE, Mitchell, Audatex, and QuickBooks — no rip-and-replace needed. We plug into your existing workflow so your team can adopt AI without disrupting current operations.",
    icon: "🔌",
  },
  {
    question: "Is my data secure?",
    answer: "Absolutely. FleetClaim AI is SOC 2 compliant with 256-bit encryption at rest and in transit. Role-based access controls ensure only authorized personnel see sensitive claim data.",
    icon: "🔒",
  },
  {
    question: "How long to get started?",
    answer: "Most fleets are fully onboarded within 48 hours. Our dedicated onboarding team handles the setup — you just need to provide access to your existing claims data and we take care of the rest.",
    icon: "🚀",
  },
];
---

<BaseLayout title="AI-Powered Fleet Claims Management" description="Stop losing money to manual claims. FleetClaim AI cuts claim processing from days to minutes with 99.7% accuracy. Start your free trial today.">
  <!-- 1. Hero — Pain → Agitation → Solution -->
  <section id="hero" class="relative overflow-hidden border-b border-navy-200/60 dark:border-navy-800/60 bg-gradient-to-br from-electric-50 via-white to-navy-50/70 dark:from-navy-950 dark:via-navy-950 dark:to-electric-950/30">
    <div class="absolute -top-32 -right-20 h-96 w-96 rounded-full bg-electric-400/15 blur-3xl" aria-hidden="true"></div>
    <div class="section-inner relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:py-28">
      <div>
        <span class="badge mb-7">🕐 The average fleet loses 12 hours per claim to paperwork</span>
        <h1 class="heading-1 mb-6 max-w-2xl text-balance text-5xl sm:text-6xl lg:text-[4.25rem]">
          Stop Losing Money to Manual Claims.
          <span class="bg-gradient-to-r from-electric-500 to-navy-600 bg-clip-text text-transparent dark:from-electric-400 dark:to-electric-300"> AI Does the Heavy Lifting.</span>
        </h1>
        <p class="body-large mb-9 max-w-xl">Every day your team spends on paperwork, estimates, and adjuster calls is money leaking from your bottom line. FleetClaim AI cuts claim processing from days to minutes — with 99.7% accuracy.</p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a href="/contact" class="btn-primary px-7 py-4 text-base">Start Saving Today <span aria-hidden="true">→</span></a>
          <a href="#how-it-works" class="btn-secondary px-7 py-4 text-base">See How It Works</a>
        </div>
        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-navy-500 dark:text-navy-400">
          <span>✓ No credit card required</span><span>✓ 14-day free trial</span><span>✓ 48-hour onboarding</span>
        </div>
      </div>
      <div class="hero-grid relative rounded-3xl p-4 sm:p-7">
        <div class="absolute inset-0 rounded-3xl bg-electric-500/5 dark:bg-electric-400/5"></div>
        <img src="/hero-illustration.png" alt="FleetClaim AI claims dashboard showing AI-powered damage analysis and estimate generation" class="relative z-10 w-full rounded-2xl shadow-2xl shadow-navy-950/20 ring-1 ring-navy-200/70 dark:ring-navy-700/70" />
      </div>
    </div>
  </section>

  <!-- 2. Pain-Point Stats Bar -->
  <section class="border-b border-navy-200/60 bg-navy-50/80 py-14 dark:border-navy-800/60 dark:bg-navy-900/50">
    <div class="section-inner">
      <p class="mb-10 text-center text-sm font-bold uppercase tracking-[0.2em] text-navy-400 dark:text-navy-500">The Hidden Cost of Manual Claims</p>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {painStats.map((stat) => (
          <div class="group relative rounded-2xl border border-navy-200/70 bg-white p-6 text-center shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5 dark:border-navy-700/70 dark:bg-navy-900">
            <span class="mb-3 block text-3xl" aria-hidden="true">{stat.icon}</span>
            <p class="mb-2 text-3xl font-extrabold tracking-tight text-navy-950 dark:text-white">{stat.number}</p>
            <p class="text-sm leading-relaxed text-navy-500 dark:text-navy-400">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Before / After Comparison -->
  <section class="section relative overflow-hidden bg-white dark:bg-navy-950">
    <div class="section-inner">
      <div class="mb-14 max-w-2xl">
        <span class="badge mb-5">The difference is clear</span>
        <h2 class="heading-2 mb-4">See what changes with FleetClaim AI</h2>
        <p class="body-large">Fleet teams waste days on manual claims. AI-powered automation transforms the entire process.</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Without FleetClaim -->
        <div class="group relative overflow-hidden rounded-2xl border-2 border-red-200/70 bg-gradient-to-br from-red-50 to-red-100/40 p-8 dark:border-red-900/50 dark:from-red-950/40 dark:to-red-950/20">
          <span class="mb-5 inline-flex items-center gap-2 rounded-full bg-red-100 px-3 py-1 text-xs font-bold text-red-700 dark:bg-red-900/50 dark:text-red-300">❌ Without FleetClaim</span>
          <ul class="space-y-4">
            {["Manual photo uploads & sorting","Spreadsheet-based claim tracking","Phone tag with adjusters & shops","8+ day claim cycle times","Missed damage & disputes","Overpriced estimates & supplements"].map((item) => (
              <li class="flex items-start gap-3 text-sm text-navy-700 dark:text-navy-300"><span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-200 text-xs font-bold text-red-700 dark:bg-red-900/50 dark:text-red-400">✕</span>{item}</li>
            ))}
          </ul>
        </div>
        <!-- With FleetClaim -->
        <div class="group relative overflow-hidden rounded-2xl border-2 border-emerald-200/70 bg-gradient-to-br from-emerald-50 to-emerald-100/40 p-8 dark:border-emerald-900/50 dark:from-emerald-950/40 dark:to-emerald-950/20">
          <span class="mb-5 inline-flex items-center gap-2 rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300">✅ With FleetClaim AI</span>
          <ul class="space-y-4">
            {["Instant AI-powered damage analysis","Automated tracking dashboard","Real-time status updates for all stakeholders","<24 hour claim cycle times","99.7% damage detection accuracy","Fair, data-driven market estimates"].map((item) => (
              <li class="flex items-start gap-3 text-sm text-navy-700 dark:text-navy-300"><span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-200 text-xs font-bold text-emerald-700 dark:bg-emerald-900/60 dark:text-emerald-400">✓</span>{item}</li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/contact" class="btn-primary px-7 py-4">Start Your Transformation →</a>
      </div>
    </div>
  </section>

  <!-- 4. Strengthened Social Proof -->
  <section class="border-y border-navy-200/60 bg-navy-50/60 py-20 dark:border-navy-800/60 dark:bg-navy-900/30">
    <div class="section-inner">
      <div class="mx-auto max-w-3xl">
        <div class="mb-6 flex justify-center">
          <div class="flex -space-x-2">
            {[0,1,2,3,4].map((i) => (
              <div class={`flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-gradient-to-br from-electric-400 to-electric-600 text-xs font-bold text-white shadow-sm dark:border-navy-950`}>
                {["MR","JT","KL","AP","SD"][i]}
              </div>
            ))}
          </div>
        </div>
        <blockquote class="relative">
          <p class="mb-6 text-center text-xl font-semibold leading-relaxed text-navy-800 dark:text-navy-100 sm:text-2xl">
            "FleetClaim AI reduced our claims cycle from 7 days to under 4 hours. We're saving $18,000/month in processing costs alone."
          </p>
          <footer class="text-center">
            <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-electric-500 to-navy-700 text-lg font-bold text-white shadow-md">MR</div>
            <p class="font-semibold text-navy-900 dark:text-white">Michael R.</p>
            <p class="text-sm text-navy-500 dark:text-navy-400">Fleet Operations Director, Apex Logistics</p>
          </footer>
        </blockquote>
        <p class="mt-10 text-center text-sm font-bold text-electric-600 dark:text-electric-400">🚛 Join 200+ fleets already using FleetClaim AI</p>
      </div>
    </div>
  </section>

  <!-- 5. How it works -->
  <section id="how-it-works" class="section relative overflow-hidden">
    <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-electric-500/5 blur-3xl" aria-hidden="true"></div>
    <div class="section-inner relative">
      <div class="mb-14 max-w-2xl">
        <span class="badge mb-5">A simpler workflow</span>
        <h2 class="heading-2 mb-4">From first photo to final settlement</h2>
        <p class="body-large">A streamlined operating system for teams that cannot afford claims to slow them down.</p>
      </div>
      <div class="relative grid gap-8 md:grid-cols-3 md:gap-10">
        <div class="absolute left-[16%] right-[16%] top-10 hidden h-px bg-gradient-to-r from-electric-300 via-electric-500 to-electric-300 md:block"></div>
        {[{n:"01",icon:"↥",title:"Upload",desc:"Upload damage photos via mobile or desktop"},{n:"02",icon:"✦",title:"Analyze",desc:"AI analyzes damage and generates estimates"},{n:"03",icon:"✓",title:"Settle",desc:"Review, approve, and settle claims faster"}].map((step) => (
          <div class="relative">
            <div class="mb-5 flex items-center justify-between">
              <span class="text-5xl font-black tracking-tight text-electric-500/25 dark:text-electric-400/25">{step.n}</span>
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-electric-400 to-electric-700 text-xl font-bold text-white shadow-lg shadow-electric-500/20">{step.icon}</span>
            </div>
            <h3 class="heading-3 mb-2">{step.title}</h3>
            <p class="body-base max-w-xs">{step.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" class="btn-primary px-7 py-4">Get Started in Under 48 Hours →</a>
      </div>
    </div>
  </section>

  <!-- 6. Product preview -->
  <section class="section border-y border-navy-200/60 bg-navy-50/60 dark:border-navy-800/60 dark:bg-navy-900/30">
    <div class="section-inner">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <span class="badge mb-5">One source of truth</span>
        <h2 class="heading-2 mb-4">Everything you need in one dashboard</h2>
        <p class="body-large">Give every stakeholder a clear view of damage, estimates, approvals, and claim status.</p>
      </div>
      <div class="mx-auto max-w-5xl rounded-2xl border border-navy-200/80 bg-navy-950 p-2 shadow-2xl shadow-navy-950/20 dark:border-navy-700">
        <div class="flex items-center gap-2 border-b border-white/10 px-3 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span><span class="ml-3 h-2.5 w-32 rounded-full bg-white/10"></span>
        </div>
        <img src="/hero-illustration.png" alt="FleetClaim AI dashboard preview showing claim tracking and estimate management" class="block w-full rounded-b-lg" />
      </div>
    </div>
  </section>

  <!-- 7. Features -->
  <section class="section">
    <div class="section-inner">
      <div class="mb-14 flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div>
          <span class="badge mb-5">Built for operations</span>
          <h2 class="heading-2 mb-4">The intelligence behind every claim</h2>
          <p class="body-large max-w-2xl">Replace fragmented tools and manual follow-ups with a claims platform designed for speed, accuracy, and accountability.</p>
        </div>
        <a href="/docs" class="link whitespace-nowrap font-semibold">Explore the platform →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {[{icon:"✦",title:"AI Damage Analysis",desc:"Identify damage type, severity, and affected parts from photos with consistent, explainable results."},{icon:"▤",title:"Smart Estimates",desc:"Generate detailed repair estimates with labor hours, parts pricing, and OEM procedures in seconds."},{icon:"↗",title:"Claim Tracking",desc:"Keep every claim moving with real-time status, ownership, and automated workflow handoffs."},{icon:"⌘",title:"Integrations",desc:"Connect the tools your team already trusts, from CCC ONE and Mitchell to QuickBooks and more."}].map((feature) => (
          <div class="card group p-7 sm:p-8">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-electric-400 to-electric-700 text-xl font-bold text-white shadow-lg shadow-electric-500/20 transition-transform group-hover:scale-110">{feature.icon}</div>
            <h3 class="heading-3 mb-3">{feature.title}</h3>
            <p class="body-base mb-5">{feature.desc}</p>
            <a href="/docs" class="link text-sm font-semibold">Learn more →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. ROI Calculator Teaser -->
  <section class="border-y border-navy-200/60 bg-gradient-to-br from-electric-50 via-white to-navy-50/70 py-20 dark:border-navy-800/60 dark:from-navy-950 dark:via-navy-950 dark:to-electric-950/20">
    <div class="section-inner">
      <div class="mx-auto max-w-3xl">
        <div class="mb-8 text-center">
          <span class="badge mb-5">ROI Calculator</span>
          <h2 class="heading-2 mb-4">How much could you save?</h2>
          <p class="body-large">Enter your monthly claim volume and see your estimated savings with FleetClaim AI.</p>
        </div>
        <div class="card overflow-hidden p-0">
          <div class="p-8 sm:p-10">
            <label for="claims-input" class="mb-3 block text-sm font-semibold text-navy-700 dark:text-navy-200">
              How many claims do you process per month?
            </label>
            <div class="flex items-center gap-4">
              <input
                id="claims-input"
                type="range"
                min="5"
                max="500"
                value="50"
                step="5"
                class="roi-slider h-2 w-full cursor-pointer appearance-none rounded-full bg-navy-200 accent-electric-500 dark:bg-navy-700"
              />
              <output id="claims-count" class="flex h-14 w-20 shrink-0 items-center justify-center rounded-xl border-2 border-electric-500 bg-electric-50 text-xl font-extrabold text-electric-600 dark:bg-electric-950 dark:text-electric-400">50</output>
            </div>
            <div class="mt-8 grid gap-6 sm:grid-cols-2">
              <div class="rounded-xl bg-emerald-50 p-5 text-center dark:bg-emerald-950/30">
                <p class="mb-1 text-sm font-medium text-emerald-700 dark:text-emerald-400">Monthly Savings</p>
                <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">
                  <span id="savings-dollar">$12,000</span>
                </p>
                <p class="text-xs text-emerald-600/70 dark:text-emerald-400/70">at $240 saved per claim</p>
              </div>
              <div class="rounded-xl bg-electric-50 p-5 text-center dark:bg-electric-950/30">
                <p class="mb-1 text-sm font-medium text-electric-700 dark:text-electric-400">Hours Reclaimed</p>
                <p class="text-3xl font-extrabold text-electric-600 dark:text-electric-400">
                  <span id="savings-hours">575</span> hrs
                </p>
                <p class="text-xs text-electric-600/70 dark:text-electric-400/70">at 11.5 hours saved per claim</p>
              </div>
            </div>
          </div>
          <div class="border-t border-navy-200/60 bg-navy-50/50 px-8 py-5 text-center dark:border-navy-800/60 dark:bg-navy-900/50">
            <a href="/contact" class="btn-primary px-7 py-4">See Your Full Savings →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Objection Handling -->
  <section class="section bg-white dark:bg-navy-950">
    <div class="section-inner">
      <div class="mb-14 max-w-2xl">
        <span class="badge mb-5">Your questions, answered</span>
        <h2 class="heading-2 mb-4">No surprises. No hype. Just the facts.</h2>
        <p class="body-large">We know switching claims platforms is a big decision. Here's what you need to know.</p>
      </div>
      <div class="mx-auto grid max-w-3xl gap-4">
        {objections.map((obj) => (
          <details class="card group cursor-pointer overflow-hidden transition-all duration-200 hover:border-electric-300 dark:hover:border-electric-700">
            <summary class="flex items-center gap-4 p-5 font-semibold text-navy-900 dark:text-white list-none">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-navy-100 text-lg dark:bg-navy-800" aria-hidden="true">{obj.icon}</span>
              <span class="flex-1">{obj.question}</span>
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy-100 text-sm font-bold text-electric-500 transition-transform duration-200 group-open:rotate-45 dark:bg-navy-800">+</span>
            </summary>
            <div class="px-5 pb-5 pl-[72px]">
              <p class="text-sm leading-relaxed text-navy-600 dark:text-navy-300">{obj.answer}</p>
            </div>
          </details>
        ))}
      </div>
      <div class="mt-10 text-center">
        <p class="mb-4 text-sm text-navy-500 dark:text-navy-400">Still have questions?</p>
        <a href="/contact" class="btn-primary px-7 py-4">Talk to Our Team →</a>
      </div>
    </div>
  </section>

  <!-- 10. Integrations -->
  <section class="border-y border-navy-200/60 bg-white py-16 dark:border-navy-800/60 dark:bg-navy-950">
    <div class="section-inner text-center">
      <p class="mb-8 text-sm font-semibold text-navy-500 dark:text-navy-400">Integrates with your existing tools</p>
      <div class="flex flex-wrap justify-center gap-3">
        {integrations.map(([name, color]) => (
          <span class={`rounded-lg border border-navy-200 bg-navy-50 px-5 py-3 text-sm font-extrabold tracking-tight ${color} dark:border-navy-800 dark:bg-navy-900`}>{name}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. Trust Badges Bar -->
  <section class="border-b border-navy-200/60 bg-navy-50/60 py-12 dark:border-navy-800/60 dark:bg-navy-900/30">
    <div class="section-inner">
      <p class="mb-8 text-center text-xs font-bold uppercase tracking-[0.2em] text-navy-400 dark:text-navy-500">Trusted by fleet professionals</p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {[
          { icon: "🎯", label: "99.7% Accuracy" },
          { icon: "🛡️", label: "SOC 2 Compliant" },
          { icon: "🔐", label: "256-bit Encryption" },
          { icon: "🎁", label: "14-Day Free Trial" },
          { icon: "💳", label: "No Credit Card Required" },
        ].map((badge) => (
          <div class="flex items-center gap-2 rounded-lg border border-navy-200/70 bg-white px-4 py-2.5 text-sm font-semibold text-navy-700 shadow-sm dark:border-navy-700/70 dark:bg-navy-900 dark:text-navy-300">
            <span aria-hidden="true">{badge.icon}</span>
            {badge.label}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. CTA -->
  <section class="section">
    <div class="section-inner">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-electric-500 via-electric-600 to-navy-800 px-6 py-20 text-center shadow-2xl shadow-electric-500/20 sm:px-12">
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative">
          <span class="badge mb-6 bg-white/15 text-white">Move claims forward</span>
          <h2 class="mb-5 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">Ready to stop losing money to manual claims?</h2>
          <p class="mx-auto mb-9 max-w-xl text-lg leading-relaxed text-electric-100">Join 200+ fleets saving an average of $18,000/month with AI-powered claims automation.</p>
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a href="/contact" class="inline-flex items-center gap-2 rounded-lg bg-white px-8 py-4 font-bold text-electric-600 transition hover:bg-electric-50">Start Saving Today <span aria-hidden="true">→</span></a>
            <a href="/docs" class="font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white">or browse our documentation</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile sticky CTA -->
  <div class="mobile-cta-bar fixed bottom-0 left-0 right-0 z-40 border-t border-navy-200/60 bg-white/95 px-4 py-3 backdrop-blur-xl dark:border-navy-800/60 dark:bg-navy-950/95 sm:hidden">
    <a href="/contact" class="btn-primary w-full py-3 text-base font-bold">Get Started Free →</a>
  </div>
</BaseLayout>

<!-- ROI Calculator Script -->
<script>
  const slider = document.getElementById("claims-input") as HTMLInputElement;
  const countDisplay = document.getElementById("claims-count");
  const savingsDollar = document.getElementById("savings-dollar");
  const savingsHours = document.getElementById("savings-hours");

  function formatCurrency(n: number): string {
    return "$" + n.toLocaleString("en-US");
  }

  function formatHours(n: number): string {
    return n.toLocaleString("en-US");
  }

  function updateCalculator() {
    if (!slider || !countDisplay || !savingsDollar || !savingsHours) return;
    const claims = parseInt(slider.value, 10);
    countDisplay.textContent = String(claims);
    savingsDollar.textContent = formatCurrency(claims * 240);
    savingsHours.textContent = formatHours(claims * 11.5);
  }

  slider?.addEventListener("input", updateCalculator);
  updateCalculator();
</script>

<style>
  /* ROI slider styling */
  .roi-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #3b82f6;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
  }
  .roi-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #3b82f6;
    cursor: pointer;
    border: none;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
  }

  /* Mobile CTA bar */
  .mobile-cta-bar {
