---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Dashboard"
  description="Analytics dashboard preview. Monitor fleet claims, track repair progress, and view key metrics at a glance."
>
  <section class="section">
    <div class="section-inner">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="badge mb-2">Preview</span>
          <h1 class="heading-2">Analytics Dashboard</h1>
          <p class="body-base mt-2">Static preview &mdash; live data will be available after product launch.</p>
        </div>
        <div class="hidden sm:flex items-center gap-3">
          <span class="text-sm text-navy-400 dark:text-navy-500">Last 30 days</span>
          <div class="w-32 h-9 rounded-lg bg-navy-100 dark:bg-navy-800 flex items-center justify-center text-sm text-navy-500 dark:text-navy-400">
            Filter ▾
          </div>
        </div>
      </div>

      <!-- Metric Cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div class="card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm font-medium text-navy-500 dark:text-navy-400">Total Claims</span>
            <span class="w-8 h-8 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center">
              <svg class="w-4 h-4 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
            </span>
          </div>
          <div class="text-3xl font-bold text-navy-950 dark:text-white mb-1">1,247</div>
          <div class="text-xs text-emerald-500 font-medium">↑ 12.4%</div>
        </div>
        <div class="card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm font-medium text-navy-500 dark:text-navy-400">Avg. Cycle Time</span>
            <span class="w-8 h-8 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center">
              <svg class="w-4 h-4 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
          </div>
          <div class="text-3xl font-bold text-navy-950 dark:text-white mb-1">4.2<span class="text-lg font-normal text-navy-400"> days</span></div>
          <div class="text-xs text-emerald-500 font-medium">↓ 18.7%</div>
        </div>
        <div class="card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm font-medium text-navy-500 dark:text-navy-400">Estimate Accuracy</span>
            <span class="w-8 h-8 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center">
              <svg class="w-4 h-4 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            </span>
          </div>
          <div class="text-3xl font-bold text-navy-950 dark:text-white mb-1">99.7<span class="text-lg font-normal text-navy-400">%</span></div>
          <div class="text-xs text-emerald-500 font-medium">↑ 0.3%</div>
        </div>
        <div class="card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm font-medium text-navy-500 dark:text-navy-400">Active Vehicles</span>
            <span class="w-8 h-8 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center">
              <svg class="w-4 h-4 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
            </span>
          </div>
          <div class="text-3xl font-bold text-navy-950 dark:text-white mb-1">342</div>
          <div class="text-xs text-emerald-500 font-medium">↑ 8.2%</div>
        </div>
      </div>

      <!-- Chart Placeholders -->
      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 card p-6">
          <h3 class="text-sm font-semibold text-navy-900 dark:text-white mb-6">Claims Over Time</h3>
          <div class="h-64 bg-navy-50 dark:bg-navy-800/50 rounded-lg flex items-center justify-center">
            <div class="text-center">
              <svg class="w-12 h-12 text-navy-200 dark:text-navy-700 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5"/></svg>
              <span class="text-sm text-navy-400 dark:text-navy-500">Live chart coming soon</span>
            </div>
          </div>
        </div>

        <div class="card p-6">
          <h3 class="text-sm font-semibold text-navy-900 dark:text-white mb-6">Claim Status</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-navy-600 dark:text-navy-300">Submitted</span>
              <span class="text-sm font-semibold text-navy-900 dark:text-white">412</span>
            </div>
            <div class="w-full h-2 rounded-full bg-navy-100 dark:bg-navy-800">
              <div class="h-2 rounded-full bg-electric-500" style="width: 33%"></div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-navy-600 dark:text-navy-300">In Review</span>
              <span class="text-sm font-semibold text-navy-900 dark:text-white">298</span>
            </div>
            <div class="w-full h-2 rounded-full bg-navy-100 dark:bg-navy-800">
              <div class="h-2 rounded-full bg-amber-400" style="width: 24%"></div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-navy-600 dark:text-navy-300">Approved</span>
              <span class="text-sm font-semibold text-navy-900 dark:text-white">389</span>
            </div>
            <div class="w-full h-2 rounded-full bg-navy-100 dark:bg-navy-800">
              <div class="h-2 rounded-full bg-emerald-500" style="width: 31%"></div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-navy-600 dark:text-navy-300">Settled</span>
              <span class="text-sm font-semibold text-navy-900 dark:text-white">148</span>
            </div>
            <div class="w-full h-2 rounded-full bg-navy-100 dark:bg-navy-800">
              <div class="h-2 rounded-full bg-navy-400 dark:bg-navy-500" style="width: 12%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
