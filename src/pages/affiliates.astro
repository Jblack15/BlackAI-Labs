---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Affiliate Program"
  description="Partner with FleetClaim AI and refer fleet claims management, AI damage analysis, and insurance claims automation to your network."
>
  <section class="section">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="badge mb-4">Partners</span>
        <h1 class="heading-1 mb-4">Affiliate Program</h1>
        <p class="body-large max-w-2xl mx-auto">
          Earn recurring commissions by introducing FleetClaim AI to your network.
          Perfect for insurance brokers, fleet consultants, and industry influencers.
        </p>
      </div>

      <!-- How it works -->
      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto mb-20">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center">
            <span class="text-2xl font-extrabold text-electric-500">1</span>
          </div>
          <h2 class="font-semibold text-navy-900 dark:text-white mb-2">Sign Up</h2>
          <p class="text-sm text-navy-500 dark:text-navy-400">
            Join the program and get your unique referral link in minutes.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center">
            <span class="text-2xl font-extrabold text-electric-500">2</span>
          </div>
          <h2 class="font-semibold text-navy-900 dark:text-white mb-2">Share</h2>
          <p class="text-sm text-navy-500 dark:text-navy-400">
            Recommend FleetClaim AI to fleet operators and repair shops in your network.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center">
            <span class="text-2xl font-extrabold text-electric-500">3</span>
          </div>
          <h2 class="font-semibold text-navy-900 dark:text-white mb-2">Earn</h2>
          <p class="text-sm text-navy-500 dark:text-navy-400">
            Earn 20% recurring commission on every customer you refer — for the life of their subscription.
          </p>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <div class="card p-10 max-w-lg mx-auto">
          <h2 class="heading-3 mb-4">Program Launching Soon</h2>
          <p class="body-base mb-8">
            Our affiliate program will activate after the product launch. Sign up for
            early access and be among the first to earn.
          </p>
          <a href="/contact" class="btn-primary w-full">Get Notified When We Launch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
