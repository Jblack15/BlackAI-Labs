---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Documentation"
  description="Learn how to use FleetClaim AI with our comprehensive documentation, guides, and API reference."
>
  <section class="section">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="badge mb-4">Docs</span>
        <h1 class="heading-1 mb-4">Knowledge Base</h1>
        <p class="body-large max-w-2xl mx-auto">
          Everything you need to know about FleetClaim AI &mdash; from getting started to advanced features.
        </p>
      </div>

      <!-- Search placeholder -->
      <div class="max-w-xl mx-auto mb-16">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-navy-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
          <input
            type="search"
            placeholder="Search documentation..."
            disabled
            class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-navy-200 dark:border-navy-700
                   bg-white dark:bg-navy-900 text-navy-900 dark:text-white
                   placeholder:text-navy-400 dark:placeholder:text-navy-500
                   text-sm cursor-not-allowed opacity-70"
          />
        </div>
      </div>

      <!-- Doc categories grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <a href="#" class="card p-6 group hover:border-electric-300 dark:hover:border-electric-700">
          <div class="w-10 h-10 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
          </div>
          <h3 class="font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">Getting Started</h3>
          <p class="text-sm text-navy-500 dark:text-navy-400">Quickstart guide, account setup, and platform overview.</p>
        </a>

        <a href="#" class="card p-6 group hover:border-electric-300 dark:hover:border-electric-700">
          <div class="w-10 h-10 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/></svg>
          </div>
          <h3 class="font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">AI Features</h3>
          <p class="text-sm text-navy-500 dark:text-navy-400">Damage analysis, estimate generation, and AI capabilities.</p>
        </a>

        <a href="#" class="card p-6 group hover:border-electric-300 dark:hover:border-electric-700">
          <div class="w-10 h-10 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l7.98-7.98m-1.17-1.17a14.837 14.837 0 00-18.25 18.25l18.25-18.25z"/></svg>
          </div>
          <h3 class="font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">API Reference</h3>
          <p class="text-sm text-navy-500 dark:text-navy-400">REST API endpoints, authentication, and integration guides.</p>
        </a>

        <a href="#" class="card p-6 group hover:border-electric-300 dark:hover:border-electric-700">
          <div class="w-10 h-10 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          </div>
          <h3 class="font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">Security & Compliance</h3>
          <p class="text-sm text-navy-500 dark:text-navy-400">Data protection, SOC 2 compliance, and privacy practices.</p>
        </a>

        <a href="#" class="card p-6 group hover:border-electric-300 dark:hover:border-electric-700">
          <div class="w-10 h-10 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155"/></svg>
          </div>
          <h3 class="font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">Support</h3>
          <p class="text-sm text-navy-500 dark:text-navy-400">FAQs, troubleshooting guides, and how to contact our support team.</p>
        </a>

        <a href="#" class="card p-6 group hover:border-electric-300 dark:hover:border-electric-700">
          <div class="w-10 h-10 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"/></svg>
          </div>
          <h3 class="font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">Integrations</h3>
          <p class="text-sm text-navy-500 dark:text-navy-400">CCC ONE, Mitchell, Audatex, QuickBooks, and third-party integrations.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
