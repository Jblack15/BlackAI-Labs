---
import { getCollection } from 'astro:content';
import BaseLayout from "../layouts/BaseLayout.astro";
const articles = (await getCollection('docs')).sort((a,b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="FleetClaim AI Documentation" description="Guides for fleet claims management, AI damage analysis, repair estimates, claims tracking, and the FleetClaim AI API."><section class="section"><div class="section-inner"><div class="text-center mb-16"><span class="badge mb-4">Docs</span><h1 class="heading-1 mb-4">Knowledge Base</h1><p class="body-large max-w-2xl mx-auto">Everything you need to know about FleetClaim AI—from getting started to advanced features.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">{articles.map(({id,data}) => <a href={`/docs/${id.replace(/\.md$/, "")}`} class="card p-6 group hover:border-electric-300 dark:hover:border-electric-700"><div class="w-10 h-10 rounded-lg bg-electric-100 dark:bg-electric-900/50 flex items-center justify-center mb-4 text-electric-500">→</div><h2 class="font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500">{data.title}</h2><p class="text-sm text-navy-500 dark:text-navy-400">{data.description}</p><time class="block mt-4 text-xs text-navy-400">Updated {data.updated.toLocaleDateString('en-US',{month:'short',year:'numeric'})}</time></a>)}</div></div></section></BaseLayout>
