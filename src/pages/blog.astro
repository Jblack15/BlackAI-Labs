---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Blog"
  description="Insights, guides, and updates on AI in fleet management, damage assessment, and insurance claims automation."
>
  <section class="section">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="badge mb-4">Blog</span>
        <h1 class="heading-1 mb-4">FleetClaim AI Blog</h1>
        <p class="body-large max-w-2xl mx-auto">
          Industry insights, product updates, and best practices for fleet claims management.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Placeholder articles -->
        <article class="card overflow-hidden group cursor-pointer">
          <div class="h-48 bg-navy-100 dark:bg-navy-800 flex items-center justify-center">
            <svg class="w-12 h-12 text-navy-300 dark:text-navy-600" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs text-electric-500 font-medium">Product</span>
              <span class="text-xs text-navy-400">&middot;</span>
              <span class="text-xs text-navy-400">Coming Soon</span>
            </div>
            <h2 class="text-lg font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">
              How AI Is Transforming Fleet Claims Management
            </h2>
            <p class="text-sm text-navy-500 dark:text-navy-400 line-clamp-2">
              Discover how artificial intelligence is reducing claim cycle times and improving accuracy across the industry.
            </p>
          </div>
        </article>

        <article class="card overflow-hidden group cursor-pointer">
          <div class="h-48 bg-navy-100 dark:bg-navy-800 flex items-center justify-center">
            <svg class="w-12 h-12 text-navy-300 dark:text-navy-600" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs text-electric-500 font-medium">Guide</span>
              <span class="text-xs text-navy-400">&middot;</span>
              <span class="text-xs text-navy-400">Coming Soon</span>
            </div>
            <h2 class="text-lg font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">
              The Complete Guide to Fleet Damage Documentation
            </h2>
            <p class="text-sm text-navy-500 dark:text-navy-400 line-clamp-2">
              Best practices for documenting vehicle damage to ensure faster claim approvals and accurate estimates.
            </p>
          </div>
        </article>

        <article class="card overflow-hidden group cursor-pointer">
          <div class="h-48 bg-navy-100 dark:bg-navy-800 flex items-center justify-center">
            <svg class="w-12 h-12 text-navy-300 dark:text-navy-600" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs text-electric-500 font-medium">Industry</span>
              <span class="text-xs text-navy-400">&middot;</span>
              <span class="text-xs text-navy-400">Coming Soon</span>
            </div>
            <h2 class="text-lg font-semibold text-navy-900 dark:text-white mb-2 group-hover:text-electric-500 transition-colors">
              2026 Fleet Management Trends to Watch
            </h2>
            <p class="text-sm text-navy-500 dark:text-navy-400 line-clamp-2">
              Key trends shaping the future of fleet management, from AI to sustainability and beyond.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
