---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact Us" description="Get in touch with the FleetClaim AI team. Request a demo, ask a question, or learn how we can help your fleet operations.">
  <section class="section"><div class="section-inner max-w-3xl">
    <div class="text-center mb-12"><span class="badge mb-4">Contact</span><h1 class="heading-1 mb-4">Let&rsquo;s talk</h1><p class="body-large">Ready to see FleetClaim AI in action? Tell us a little about your operation and our team will get back to you within one business day.</p></div>
    <div id="success-message" class="hidden mb-6 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800 dark:border-green-900 dark:bg-green-950/40 dark:text-green-300" role="status">Thanks for reaching out! Your request has been saved. We&rsquo;ll be in touch within one business day.</div>
    <div class="card p-8 md:p-12"><form id="demo-form" class="space-y-6" novalidate>
      <div class="grid sm:grid-cols-2 gap-6"><div><label for="first-name" class="field-label">First name <span>*</span></label><input type="text" id="first-name" name="firstName" required autocomplete="given-name" placeholder="Jordan" class="field" /><p class="field-error" data-error-for="first-name"></p></div><div><label for="last-name" class="field-label">Last name <span>*</span></label><input type="text" id="last-name" name="lastName" required autocomplete="family-name" placeholder="Lee" class="field" /><p class="field-error" data-error-for="last-name"></p></div></div>
      <div><label for="email" class="field-label">Work email <span>*</span></label><input type="email" id="email" name="email" required autocomplete="email" placeholder="jordan@fleetcompany.com" class="field" /><p class="field-error" data-error-for="email"></p></div>
      <div><label for="company" class="field-label">Company name <span>*</span></label><input type="text" id="company" name="company" required autocomplete="organization" placeholder="Acme Fleet Services" class="field" /><p class="field-error" data-error-for="company"></p></div>
      <div><label for="role" class="field-label">What best describes you? <span>*</span></label><select id="role" name="role" required class="field"><option value="">Select your role</option><option>Fleet Operator</option><option>Repair Shop</option><option>Insurance Carrier</option><option>Independent Adjuster</option><option>Other</option></select><p class="field-error" data-error-for="role"></p></div>
      <input type="hidden" id="plan" name="plan" value="" />
      <div><label for="message" class="field-label">How can we help? <span>*</span></label><textarea id="message" name="message" rows="4" required minlength="10" placeholder="Tell us about your fleet and what you're looking for..." class="field resize-y"></textarea><p class="field-error" data-error-for="message"></p></div>
      <button id="submit-button" type="submit" class="btn-primary w-full text-base py-4"><span id="submit-label">Request a demo</span><span id="submit-loading" class="hidden">Saving your request…</span></button>
    </form><p class="text-xs text-navy-400 dark:text-navy-500 mt-4 text-center">Your information is used only to respond to your request. Questions? <a class="link" href="mailto:fleetclaim-ai-27b8975b@ctomail.io">fleetclaim-ai-27b8975b@ctomail.io</a></p></div>
  </div></section>
</BaseLayout>
<style>
  .field-label { display:block; margin-bottom:.5rem; font-size:.875rem; font-weight:500; color:var(--color-navy-700); } .dark .field-label { color:var(--color-navy-200); } .field-label span { color:#ef4444; }
  .field { width:100%; border-radius:.5rem; border:1px solid var(--color-navy-200); background:white; color:var(--color-navy-900); padding:.75rem 1rem; font-size:.875rem; transition:all .2s; } .dark .field { border-color:var(--color-navy-700); background:var(--color-navy-900); color:white; } .field:focus { outline:2px solid var(--color-electric-500); outline-offset:1px; border-color:transparent; } .field.invalid { border-color:#ef4444; } .field-error { min-height:1.25rem; margin-top:.25rem; color:#ef4444; font-size:.75rem; }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#demo-form'); const planField = document.querySelector<HTMLInputElement>('#plan'); const params = new URLSearchParams(window.location.search); const selectedPlan = params.get('plan'); if (selectedPlan && planField) planField.value = selectedPlan;
  form?.addEventListener('submit', async (event) => { event.preventDefault(); let valid = true; form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[required]').forEach((field) => { const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`); let message = ''; if (!field.value.trim()) message = 'This field is required.'; else if (field.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value)) message = 'Enter a valid email address.'; else if (field.id === 'message' && field.value.trim().length < 10) message = 'Please share at least 10 characters.'; field.classList.toggle('invalid', !!message); if (error) error.textContent = message; if (message) valid = false; }); if (!valid) { form.querySelector<HTMLElement>('.invalid')?.focus(); return; }
    const button = document.querySelector<HTMLButtonElement>('#submit-button'); button?.setAttribute('disabled', 'true'); document.querySelector('#submit-label')?.classList.add('hidden'); document.querySelector('#submit-loading')?.classList.remove('hidden'); await new Promise((resolve) => setTimeout(resolve, 700)); const data = Object.fromEntries(new FormData(form)); const key = 'fleetclaim-leads'; let leads: unknown[] = []; try { leads = JSON.parse(localStorage.getItem(key) || '[]'); } catch {} leads.push({ ...data, submittedAt: new Date().toISOString() }); localStorage.setItem(key, JSON.stringify(leads)); console.info('[FleetClaim AI] Demo request captured:', data); document.querySelector('#success-message')?.classList.remove('hidden'); form.reset(); if (planField) planField.value = selectedPlan || ''; button?.removeAttribute('disabled'); document.querySelector('#submit-label')?.classList.remove('hidden'); document.querySelector('#submit-loading')?.classList.add('hidden'); window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
