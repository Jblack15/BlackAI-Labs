---
import BaseLayout from "../layouts/BaseLayout.astro";

const plans = [
  { name: "Starter", monthly: 99, description: "For small fleets getting started with automation.", cta: "Start Free Trial", style: "btn-secondary", features: ["Up to 50 claims/month", "AI damage analysis", "Basic estimate generation", "Email support"] },
  { name: "Professional", monthly: 249, description: "For growing fleets that need advanced features.", cta: "Subscribe Now", style: "btn-primary", popular: true, features: ["Up to 200 claims/month", "Advanced AI analysis", "Full estimate generation", "Claim tracking dashboard", "Priority support"] },
  { name: "Enterprise", monthly: 499, description: "For large fleets with custom requirements.", cta: "Contact Sales", style: "btn-secondary", features: ["Unlimited claims", "Custom AI model training", "API access", "Dedicated account manager", "SLA guarantee"] },
];
const comparison = [
  ["Claims per month", "50", "200", "Unlimited"], ["AI damage analysis", "Basic", "Advanced", "Custom models"], ["Estimate generation", "Basic", "Full", "Full + API"], ["Claim tracking", "—", "✓", "✓"], ["Support", "Email", "Priority", "Dedicated manager"],
];
const faqs = [
  ["Can I try FleetClaim AI before subscribing?", "Yes. Every plan includes a 14-day free trial with no credit card required."],
  ["Can I change plans later?", "Absolutely. Upgrade or downgrade whenever your fleet's needs change."],
  ["What counts as a claim?", "A claim is a vehicle damage case processed through FleetClaim AI, from inspection through estimate."],
  ["Is my data secure?", "We use industry-standard encryption and access controls to keep your fleet and claim data protected."],
  ["Do you offer annual billing?", "Yes. Annual billing saves 20%—you pay for 10 months and get 12 months of service."],
];
---
<BaseLayout title="Pricing" description="Flexible FleetClaim AI pricing for fleet claims management, AI damage analysis, repair estimates, and claims automation.">
  <section class="section"><div class="section-inner">
    <div class="text-center mb-10"><span class="badge mb-4">Pricing</span><h1 class="heading-1 mb-4">Simple, transparent pricing</h1><p class="body-large max-w-2xl mx-auto">Choose the plan that fits your fleet. All plans include a 14-day free trial.</p></div>
    <div class="flex justify-center mb-12"><div class="inline-flex rounded-full border border-navy-200 dark:border-navy-700 p-1 bg-navy-50 dark:bg-navy-900" role="group" aria-label="Billing frequency"><button id="monthly" class="billing-toggle rounded-full px-5 py-2 text-sm font-semibold bg-white dark:bg-navy-700 text-navy-900 dark:text-white shadow-sm" aria-pressed="true">Monthly</button><button id="annual" class="billing-toggle rounded-full px-5 py-2 text-sm font-semibold text-navy-500 dark:text-navy-300" aria-pressed="false">Annual <span class="text-electric-500">Save 20%</span></button></div></div>
    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      {plans.map((plan) => <div class={`card p-8 flex flex-col relative ${plan.popular ? "ring-2 ring-electric-500" : ""}`}>{plan.popular && <span class="badge absolute -top-4 left-1/2 -translate-x-1/2 bg-electric-500 text-white">Most Popular</span>}<div class="mb-6"><h2 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{plan.name}</h2><p class="text-sm text-navy-500 dark:text-navy-400">{plan.description}</p></div><div class="mb-6"><span class="plan-price text-5xl font-extrabold text-navy-950 dark:text-white" data-monthly={plan.monthly}>${plan.monthly}</span><span class="text-navy-500 dark:text-navy-400">/month</span><p class="annual-note hidden text-xs text-electric-600 dark:text-electric-400 mt-1">Billed annually</p></div><ul class="space-y-3 mb-8 flex-1">{plan.features.map((feature) => <li class="flex items-start gap-3 text-sm text-navy-600 dark:text-navy-300"><span class="text-electric-500 font-bold">✓</span>{feature}</li>)}</ul><a href={`/contact?plan=${plan.name.toLowerCase()}`} class={`${plan.style} w-full text-center`}>{plan.cta}</a></div>)}
    </div>
    <p class="text-center mt-8 text-sm text-navy-400 dark:text-navy-500">Plans are tailored with you during your demo. Questions? <a class="link" href="mailto:fleetclaim-ai-27b8975b@ctomail.io">Contact our team</a>.</p>
    <div class="mt-24"><div class="text-center mb-10"><span class="badge mb-4">Compare plans</span><h2 class="heading-2">Everything you need to move faster</h2></div><div class="overflow-x-auto card"><table class="w-full min-w-[680px] text-left text-sm"><thead class="bg-navy-50 dark:bg-navy-800/60"><tr><th class="p-5 font-semibold">Features</th><th class="p-5 font-semibold">Starter</th><th class="p-5 font-semibold text-electric-600 dark:text-electric-400">Professional</th><th class="p-5 font-semibold">Enterprise</th></tr></thead><tbody>{comparison.map((row) => <tr class="border-t border-navy-100 dark:border-navy-800"><th class="p-5 font-medium text-navy-700 dark:text-navy-200">{row[0]}</th>{row.slice(1).map((value) => <td class="p-5 text-navy-500 dark:text-navy-400">{value}</td>)}</tr>)}</tbody></table></div></div>
    <div class="mt-24 max-w-3xl mx-auto"><div class="text-center mb-10"><span class="badge mb-4">FAQ</span><h2 class="heading-2">Questions, answered</h2></div><div class="space-y-3">{faqs.map(([question, answer]) => <details class="card p-5 group"><summary class="cursor-pointer list-none flex justify-between gap-4 font-semibold text-navy-900 dark:text-white">{question}<span class="text-electric-500 group-open:rotate-45 transition-transform">+</span></summary><p class="mt-3 text-sm leading-relaxed text-navy-600 dark:text-navy-300">{answer}</p></details>)}</div></div>
  </div></section>
</BaseLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.billing-toggle');
  buttons.forEach((button) => button.addEventListener('click', () => { const annual = button.id === 'annual'; buttons.forEach((b) => { b.classList.toggle('bg-white', b === button); b.classList.toggle('dark:bg-navy-700', b === button); b.classList.toggle('shadow-sm', b === button); b.setAttribute('aria-pressed', String(b === button)); }); document.querySelectorAll<HTMLElement>('.plan-price').forEach((el) => { const monthly = Number(el.dataset.monthly); el.textContent = `$${annual ? Math.round(monthly * 0.8 * 10) : monthly}`; }); document.querySelectorAll<HTMLElement>('.annual-note').forEach((el) => el.classList.toggle('hidden', !annual)); }));
</script>
